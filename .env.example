# ─────────────────────────────────────────────
# 이 파일을 .env 로 복사해서 값을 채웁니다.
# .env 는 gitignore 대상이라 커밋되지 않습니다.
# ─────────────────────────────────────────────

# 서버를 실제로 호출할지. 비워두거나 false 면 목 데이터로 돌아갑니다.
# 백엔드가 붙기 전에는 켜지 마세요.
VITE_API_LIVE=false

# 백엔드 주소 (끝에 / 없이)
# 예: https://api.example.com
VITE_API_BASE=

# 구글 로그인을 시작하는 백엔드 엔드포인트.
# 프론트가 구글로 직접 가지 않고 이 주소로 보냅니다.
# client_secret 과 토큰 교환은 백엔드에만 있어야 하기 때문입니다.
# 예: https://api.example.com/auth/google
VITE_GOOGLE_LOGIN_URL=
