# ─────────────────────────────────────────────
# 이 파일을 .env 로 복사해서 값을 채웁니다.
# .env 는 gitignore 대상이라 커밋되지 않습니다.
# ─────────────────────────────────────────────

# 백엔드 주소.
# 명세서의 경로가 전부 {BASE_URL}/api/v1/... 이므로 버전 접두사까지 넣습니다.
# 끝에 / 는 붙이지 마세요.
#   지금(2026-08-19 실측): http://1.201.116.42:8080/api/v1
#   도메인 붙은 뒤:        https://<도메인>/api/v1
#
# ─────────────────────────────────────────────
# .env.development 에는 `/api/v1` 만 넣어서 vite 프록시를 태우는 것이 기본입니다.
#
# 2026-08-20 백엔드가 CORS_ORIGINS 에 5174 를 넣어 줘서 **직접 불러도 됩니다.**
#   허용 출처: http://localhost:5173 · http://localhost:5174  (그 밖은 403)
# 프록시 없이 확인하려면 .env.development 의 VITE_API_BASE 를 위 절대 주소로 바꾸면 됩니다.
#
# 배포본과 같은 경로를 확인하려면 `npm run build && npm run preview` 가 낫습니다.
# preview 는 .env.production 의 절대 주소를 쓰고, 포트도 허용된 5173 으로 고정해 뒀습니다
# (기본값 4173 은 허용 목록에 없어 403 입니다 — vite.config.js 참고).
#
# ⚠️ 배포 주소가 정해지면 백엔드 CORS_ORIGINS 에 반드시 추가해야 합니다.
# ─────────────────────────────────────────────
VITE_API_BASE=http://1.201.116.42:8080/api/v1

# 구글 로그인을 시작하는 백엔드 엔드포인트.
# ⚠️ API 명세서에 OAuth 엔드포인트가 없습니다. 팀에서 넣기로 정해지면 그때 채웁니다.
VITE_GOOGLE_LOGIN_URL=

# ─────────────────────────────────────────────
# 실연동 스위치는 여기가 아니라 src/api/live.js 에 있습니다.
#
# 백엔드가 슬랙 backend 에 「이 묶음 됐습니다」를 올리면
# live.js 의 해당 줄 live 를 true 로 바꾸면 됩니다.
# 묶음째 켜려면 setBundleLive('auth') 처럼 부르면 됩니다.
#
#   auth      인증·관리항목·상태·프로필 13건  (요구사항 No.14)
#   master    카테고리·관리항목·징후 3건      (요구사항 No.19)
#   subtract  덜어내기 판정 3건               (요구사항 No.26)
#   today     오늘·안내문·홈 11건             (요구사항 No.1)
#   log       첫 발자국·기록 3건              (요구사항 No.27)
#   note      안내문 원문 1건                 (요구사항 No.28)
#   safety    케어 코치·안전 2건              (요구사항 No.29)
# ─────────────────────────────────────────────
